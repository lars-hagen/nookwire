#!/bin/sh
set -eu

ASYNCSSH_VERSION=${NOOKWIRE_ASYNCSSH_VERSION:-2.24.0}
VERSION="1.4.3"
STATE_DIR=${NOOKWIRE_SSH_STATE_DIR:-${XDG_STATE_HOME:-$HOME/.local/state}/nookwire-ssh}
SERVER_PID_FILE=$STATE_DIR/server.pid
TUNNEL_PID_FILE=$STATE_DIR/tunnel.pid
SERVER_LOG=$STATE_DIR/server.log
TUNNEL_LOG=$STATE_DIR/tunnel.log
PASSWORD_FILE=$STATE_DIR/password
SESSION_FILE=$STATE_DIR/session

usage() {
  cat <<'EOF'
Usage: nookwire-ssh COMMAND [ARGS]

  start [DIR] [--port PORT] [--slot SLOT] [--backend srvus|cloudflare|cloudflared]
              [--endpoint URL] [--hostname HOST] [--token TOKEN]
              [--accept] [--allow-tcp-forwarding]
  status
  logs [all|server|tunnel] [-f]
  stop
  proxy WSS_URL
  upgrade [REF]
  -v, --version  print the version and exit

start launches AsyncSSH plus a public tunnel in the background, exposing DIR
(default: current directory) on PORT (default 8022). PORT and SLOT may also be
given positionally, so "start", "start .", and "start /path 8022 1" all work.

--accept admits any connecting client with no authentication (no key or
password) and skips generating a password. --allow-tcp-forwarding lets a
connected client reach other TCP services on this host via ssh -L through the
session. Both can be combined with any backend.

Backends select the ingress:
  srvus       (default) reverse tunnel over srv.us slot SLOT (default 1).
  cloudflare  outbound WebSocket to a Cloudflare Worker relay; needs --endpoint
              (the deployed Worker URL). See worker/README.md.
  cloudflared Cloudflare Tunnel; needs --hostname and --token (or
              NOOKWIRE_CLOUDFLARED_TOKEN), with the tunnel ingress mapped to
              tcp://localhost:PORT.

status prints processes, credentials, and the connection command when available.
logs shows the last 100 log lines; add -f to follow.
stop terminates both background processes.
proxy bridges stdin/stdout to the cloudflare relay at WSS_URL; it is used as an
ssh ProxyCommand on the connecting machine (status prints the exact command).
upgrade re-runs the installer from REF (default main) to update in place; restart
any running server with stop then start to pick up new code.
EOF
}

die() { printf '%s\n' "$*" >&2; exit 1; }

validate_port() {
  python3 -c 'import re,sys; s=sys.argv[1]; valid=bool(re.fullmatch(r"[0-9]+", s)); valid or sys.exit(1); p=int(s); 1 <= p <= 65535 or sys.exit(1); print(p)' "$1"
}

validate_slot() {
  python3 -c 'import re,sys; s=sys.argv[1]; valid=bool(re.fullmatch(r"[0-9]+", s)); valid or sys.exit(1); n=int(s); n >= 1 or sys.exit(1); print(n)' "$1"
}

setup_state() {
  umask 077
  mkdir -p "$STATE_DIR"
  chmod 700 "$STATE_DIR"
}

prompt_authorized_key() {
  keys=$HOME/.ssh/authorized_keys
  [ -s "$keys" ] && return 0
  # Find an interactive input source. With `curl ... | sh` the shell's stdin is
  # the piped script, so fall back to the controlling terminal at /dev/tty.
  if [ -t 0 ]; then
    tty_in=
  elif { true < /dev/tty; } 2>/dev/null; then
    tty_in=/dev/tty
  else
    return 0
  fi
  printf 'No keys in ~/.ssh/authorized_keys.\n' >&2
  printf 'Paste an SSH public key to enable key auth, or press Enter to skip: ' >&2
  if [ -n "$tty_in" ]; then
    IFS= read -r pasted < "$tty_in" || return 0
  else
    IFS= read -r pasted || return 0
  fi
  case "$pasted" in
    '') printf 'Skipped; password auth only.\n' >&2; return 0 ;;
  esac
  if ! mkdir -p "$HOME/.ssh" || ! chmod 700 "$HOME/.ssh"; then
    printf 'Unable to prepare %s; skipped.\n' "$HOME/.ssh" >&2
    return 0
  fi
  tmp=$(mktemp "$HOME/.ssh/nookwire-key.XXXXXX") || {
    printf 'Unable to create a temporary file; skipped.\n' >&2
    return 0
  }
  printf '%s\n' "$pasted" > "$tmp"
  if ssh-keygen -l -f "$tmp" >/dev/null 2>&1; then
    printf '%s\n' "$pasted" >> "$keys"
    chmod 600 "$keys"
    printf 'Key added to %s.\n' "$keys" >&2
  else
    printf 'Not a valid SSH public key; skipped.\n' >&2
  fi
  rm -f "$tmp"
}

read_pid() {
  [ -f "$1" ] || return 1
  set -- $(cat "$1")
  [ "$#" -eq 2 ] || return 1
  pid=$1
  case "$pid" in ''|*[!0-9]*) return 1 ;; esac
  printf '%s\n' "$pid"
}

# Reuse a stable session (tunnel) id across restarts so the exposed endpoint
# does not change on every start; the first start persists a generated id.
get_or_create_session() {
  if [ -f "$SESSION_FILE" ] && [ -s "$SESSION_FILE" ]; then
    session=$(cat "$SESSION_FILE")
    return 0
  fi
  session=$(python3 -c 'import secrets;print(secrets.token_urlsafe(24))')
  printf '%s\n' "$session" > "$SESSION_FILE"
}

process_identity() {
  python3 -c 'import hashlib,os,pathlib,subprocess,sys; p=sys.argv[1]; f=pathlib.Path("/proc")/p/"stat"; data=f.read_text().rsplit(")",1)[1].split()[19] if f.is_file() else subprocess.check_output(["ps","-p",p,"-o","lstart="], text=True).strip(); data or sys.exit(1); print(hashlib.sha256(data.encode()).hexdigest())' "$1" 2>/dev/null
}

is_running() {
  pid=$(read_pid "$1") || return 1
  kill -0 "$pid" 2>/dev/null || return 1
  set -- $(cat "$1")
  identity=$(process_identity "$pid") || return 1
  [ "$identity" = "$2" ]
}

write_pid() {
  pid=$1
  file=$2
  identity=$(process_identity "$pid") || return 1
  printf '%s %s\n' "$pid" "$identity" > "$file"
}

port_open() {
  python3 -c 'import socket,sys; s=socket.create_connection(("127.0.0.1", int(sys.argv[1])), 0.2); s.close()' "$1" 2>/dev/null
}

stop_one() {
  file=$1
  pid=$(read_pid "$file") || { rm -f "$file"; return; }
  if is_running "$file"; then
    kill "$pid" 2>/dev/null || true
    count=0
    while is_running "$file" && [ "$count" -lt 50 ]; do
      sleep 0.1
      count=$((count + 1))
    done
    if is_running "$file"; then kill -9 "$pid" 2>/dev/null || true; fi
  fi
  rm -f "$file"
}

stop_untracked_pid() {
  pid=$1
  kill "$pid" 2>/dev/null || true
  count=0
  while kill -0 "$pid" 2>/dev/null && [ "$count" -lt 50 ]; do
    sleep 0.1
    count=$((count + 1))
  done
  if kill -0 "$pid" 2>/dev/null; then kill -9 "$pid" 2>/dev/null || true; fi
  wait "$pid" 2>/dev/null || true
}

extract_host() {
  [ -f "$TUNNEL_LOG" ] || return 1
  python3 -c 'import pathlib,re,sys; m=re.findall(r"https://([A-Za-z0-9.-]+\.srv\.us)/?", pathlib.Path(sys.argv[1]).read_text(errors="replace")); print(m[-1] if m else "")' "$TUNNEL_LOG"
}

meta_get() {
  [ -f "$STATE_DIR/meta" ] || return 0
  python3 -c 'import sys,pathlib
key=sys.argv[1]
for line in pathlib.Path(sys.argv[2]).read_text().splitlines():
    if line.startswith(key + "="):
        print(line[len(key) + 1:]); break' "$1" "$STATE_DIR/meta"
}

normalize_endpoint() {
  python3 -c 'import sys
value=sys.argv[1].strip().rstrip("/")
scheme=sys.argv[2]
for prefix in ("https://", "http://", "wss://", "ws://"):
    if value.startswith(prefix):
        value = value[len(prefix):]; break
value or sys.exit(1)
print(scheme + "://" + value)' "$1" "$2"
}

render_srvus_connect() {
  ssh_user=$1
  host=$(extract_host 2>/dev/null || true)
  if [ -n "$host" ]; then
    printf 'url: https://%s/\n' "$host"
    cat <<EOF
connect:
ssh $ssh_user@$host \\
  -o 'ProxyCommand=openssl s_client -quiet -no_ign_eof -verify_return_error -verify_hostname %h -connect %h:443 -servername %h 2>/dev/null' \\
  -o StrictHostKeyChecking=no \\
  -o UserKnownHostsFile=/dev/null \\
  -o LogLevel=ERROR
EOF
  else
    printf 'url: pending; run nookwire-ssh logs tunnel -f\n'
  fi
}

render_cloudflare_connect() {
  ssh_user=$1
  endpoint=$(meta_get endpoint)
  session=$(meta_get session)
  if [ -z "$endpoint" ] || [ -z "$session" ]; then
    printf 'url: pending; run nookwire-ssh logs tunnel -f\n'
    return
  fi
  wss=$(normalize_endpoint "$endpoint" wss 2>/dev/null || printf '%s' "$endpoint")
  https=$(normalize_endpoint "$endpoint" https 2>/dev/null || printf '%s' "$endpoint")
  printf 'url: %s/tunnel/%s\n' "$https" "$session"
  cat <<EOF
connect:
ssh $ssh_user@nookwire \\
  -o 'ProxyCommand=nookwire-ssh proxy $wss/tunnel/$session' \\
  -o StrictHostKeyChecking=no \\
  -o UserKnownHostsFile=/dev/null \\
  -o LogLevel=ERROR
EOF
  printf 'note: on the connecting machine, install nookwire-ssh (needs uv on PATH).\n'
}

render_cloudflared_connect() {
  ssh_user=$1
  hostname=$(meta_get hostname)
  if [ -z "$hostname" ]; then
    printf 'url: pending; run nookwire-ssh logs tunnel -f\n'
    return
  fi
  printf 'url: ssh://%s (via cloudflared)\n' "$hostname"
  cat <<EOF
connect:
ssh $ssh_user@$hostname \\
  -o 'ProxyCommand=cloudflared access ssh --hostname %h' \\
  -o StrictHostKeyChecking=no \\
  -o UserKnownHostsFile=/dev/null \\
  -o LogLevel=ERROR
EOF
  printf 'note: the connecting machine needs cloudflared installed.\n'
}

show_status() {
  if is_running "$SERVER_PID_FILE"; then
    printf 'server: running (pid %s)\n' "$(read_pid "$SERVER_PID_FILE")"
    server_ok=1
  else
    printf 'server: stopped\n'
    server_ok=0
  fi
  if is_running "$TUNNEL_PID_FILE"; then
    printf 'tunnel: running (pid %s)\n' "$(read_pid "$TUNNEL_PID_FILE")"
    tunnel_ok=1
  else
    printf 'tunnel: stopped\n'
    tunnel_ok=0
  fi
  ssh_user=$(id -un 2>/dev/null || echo nookwire)
  accept=$(meta_get accept)
  allow_tcp_forwarding=$(meta_get allow_tcp_forwarding)
  if [ "$accept" = 1 ]; then
    printf 'auth: none (--accept); anyone can connect\n'
  else
    [ ! -f "$PASSWORD_FILE" ] || printf 'username: %s\npassword: %s\n' "$ssh_user" "$(cat "$PASSWORD_FILE")"
    if [ -s "$HOME/.ssh/authorized_keys" ]; then
      printf 'key auth: enabled\n'
    else
      printf 'key auth: disabled; add keys to ~/.ssh/authorized_keys\n'
    fi
  fi
  if [ "$allow_tcp_forwarding" = 1 ]; then
    printf 'tcp forwarding: enabled; clients may use ssh -L through this session\n'
  else
    printf 'tcp forwarding: disabled; use --allow-tcp-forwarding\n'
  fi
  backend=$(meta_get backend)
  [ -n "$backend" ] || backend=srvus
  case "$backend" in
    cloudflare) render_cloudflare_connect "$ssh_user" ;;
    cloudflared) render_cloudflared_connect "$ssh_user" ;;
    *) render_srvus_connect "$ssh_user" ;;
  esac
  [ "$server_ok" -eq 1 ] && [ "$tunnel_ok" -eq 1 ]
}

launch_tunnel_srvus() {
  command -v ssh >/dev/null 2>&1 || { stop_one "$SERVER_PID_FILE"; die "ssh is required for the srvus backend"; }
  command -v ssh-keygen >/dev/null 2>&1 || { stop_one "$SERVER_PID_FILE"; die "ssh-keygen is required for the srvus backend"; }
  if ! mkdir -p "$HOME/.ssh" || ! chmod 700 "$HOME/.ssh"; then
    stop_one "$SERVER_PID_FILE"
    die "Unable to prepare $HOME/.ssh"
  fi
  if [ ! -s "$HOME/.ssh/id_ed25519" ]; then
    if ! ssh-keygen -q -t ed25519 -N '' -f "$HOME/.ssh/id_ed25519"; then
      stop_one "$SERVER_PID_FILE"
      die "Unable to create the srv.us tunnel key"
    fi
  fi
  # ssh refuses a private key that is readable by group or others. Correct the
  # mode if it drifted (e.g. a permissive umask wrote a non-600 key).
  key_mode=$(python3 -c 'import os,sys;print("%o"%(os.stat(sys.argv[1]).st_mode & 0o777))' "$HOME/.ssh/id_ed25519" 2>/dev/null || printf '')
  case "$key_mode" in
    600) ;;
    ?*)
      if chmod 600 "$HOME/.ssh/id_ed25519" 2>/dev/null; then
        printf 'Fixed permissions on %s (was %s, now 600)\n' "$HOME/.ssh/id_ed25519" "$key_mode" >&2
      else
        printf 'Warning: could not fix permissions on %s (mode %s)\n' "$HOME/.ssh/id_ed25519" "$key_mode" >&2
      fi
      ;;
  esac
  nohup ssh \
    -i "$HOME/.ssh/id_ed25519" \
    -o IdentitiesOnly=yes \
    -o StrictHostKeyChecking=no \
    -o UserKnownHostsFile=/dev/null \
    -o LogLevel=ERROR \
    -o ExitOnForwardFailure=yes \
    -o ServerAliveInterval=30 \
    -o ServerAliveCountMax=3 \
    srv.us -R "$slot:127.0.0.1:$port" \
    >"$TUNNEL_LOG" 2>&1 </dev/null &
  tunnel_pid=$!
}

launch_tunnel_cloudflare() {
  [ -n "$endpoint" ] || { stop_one "$SERVER_PID_FILE"; die "--endpoint is required for the cloudflare backend"; }
  ws_script=$here/nookwire_ws.py
  [ -f "$ws_script" ] || { stop_one "$SERVER_PID_FILE"; die "Missing $ws_script (needed for the cloudflare backend)"; }
  wss=$(normalize_endpoint "$endpoint" wss) || { stop_one "$SERVER_PID_FILE"; die "Invalid --endpoint: $endpoint"; }
  base_url=$wss/tunnel/$session
  nohup uv run --with websockets python "$ws_script" origin \
    --host 127.0.0.1 --port "$port" "$base_url" \
    >"$TUNNEL_LOG" 2>&1 </dev/null &
  tunnel_pid=$!
}

launch_tunnel_cloudflared() {
  command -v cloudflared >/dev/null 2>&1 || { stop_one "$SERVER_PID_FILE"; die "cloudflared is required for the cloudflared backend"; }
  [ -n "$hostname" ] || { stop_one "$SERVER_PID_FILE"; die "--hostname is required for the cloudflared backend"; }
  token=${token:-${NOOKWIRE_CLOUDFLARED_TOKEN:-}}
  [ -n "$token" ] || { stop_one "$SERVER_PID_FILE"; die "--token or NOOKWIRE_CLOUDFLARED_TOKEN is required for the cloudflared backend"; }
  # Pass the token via the environment, not argv, so it is not exposed in
  # process listings to other local users.
  TUNNEL_TOKEN=$token nohup cloudflared tunnel run \
    >"$TUNNEL_LOG" 2>&1 </dev/null &
  tunnel_pid=$!
}

backend_launch_tunnel() {
  case "$backend" in
    srvus) launch_tunnel_srvus ;;
    cloudflare) launch_tunnel_cloudflare ;;
    cloudflared) launch_tunnel_cloudflared ;;
    *) stop_one "$SERVER_PID_FILE"; die "Unknown backend: $backend" ;;
  esac
}

write_meta() {
  {
    printf 'backend=%s\n' "$backend"
    printf 'port=%s\n' "$port"
    printf 'accept=%s\n' "$accept"
    printf 'allow_tcp_forwarding=%s\n' "$allow_tcp_forwarding"
    case "$backend" in
      cloudflare)
        printf 'endpoint=%s\n' "$endpoint"
        printf 'session=%s\n' "$session"
        printf 'ws_script=%s\n' "$ws_script"
        ;;
      cloudflared)
        printf 'hostname=%s\n' "$hostname"
        ;;
    esac
  } > "$STATE_DIR/meta"
}

command=${1:-help}
[ $# -eq 0 ] || shift

case "$command" in
  start)
    root_arg=.
    port_arg=8022
    slot_arg=1
    backend=srvus
    endpoint=
    hostname=
    token=
    session=
    ws_script=
    accept=0
    allow_tcp_forwarding=0
    posn=0
    while [ $# -gt 0 ]; do
      case "$1" in
        -p|--port) shift; [ $# -ge 1 ] || die "--port needs a value"; port_arg=$1 ;;
        --port=*) port_arg=${1#*=} ;;
        -s|--slot) shift; [ $# -ge 1 ] || die "--slot needs a value"; slot_arg=$1 ;;
        --slot=*) slot_arg=${1#*=} ;;
        --backend) shift; [ $# -ge 1 ] || die "--backend needs a value"; backend=$1 ;;
        --backend=*) backend=${1#*=} ;;
        --endpoint) shift; [ $# -ge 1 ] || die "--endpoint needs a value"; endpoint=$1 ;;
        --endpoint=*) endpoint=${1#*=} ;;
        --hostname) shift; [ $# -ge 1 ] || die "--hostname needs a value"; hostname=$1 ;;
        --hostname=*) hostname=${1#*=} ;;
        --token) shift; [ $# -ge 1 ] || die "--token needs a value"; token=$1 ;;
        --token=*) token=${1#*=} ;;
        --accept) accept=1 ;;
        --allow-tcp-forwarding) allow_tcp_forwarding=1 ;;
        -h|--help) usage; exit 0 ;;
        -*) die "Unknown option: $1 (see nookwire-ssh help)" ;;
        *)
          posn=$((posn + 1))
          case "$posn" in
            1) root_arg=$1 ;;
            2) port_arg=$1 ;;
            3) slot_arg=$1 ;;
            *) die "Too many arguments: $1" ;;
          esac
          ;;
      esac
      shift
    done
    case "$backend" in
      srvus|cloudflare|cloudflared) ;;
      *) die "Unknown backend: $backend (use srvus, cloudflare, or cloudflared)" ;;
    esac
    port=$(validate_port "$port_arg") || die "PORT must contain only ASCII digits and be from 1 to 65535"
    slot=$(validate_slot "$slot_arg") || die "SLOT must be a positive integer"
    root=$(CDPATH= cd "$root_arg" 2>/dev/null && pwd) || die "REMOTE_ROOT is not a directory: $root_arg"
    command -v uv >/dev/null 2>&1 || die "uv is required"
    here=$(CDPATH= cd "$(dirname "$0")" && pwd)
    server_script=$here/nookwire_ssh.py
    [ -f "$server_script" ] || die "Missing server companion: $server_script"
    setup_state
    ! is_running "$SERVER_PID_FILE" || die "Server is already running"
    ! is_running "$TUNNEL_PID_FILE" || die "Tunnel is already running"
    rm -f "$SERVER_PID_FILE" "$TUNNEL_PID_FILE"
    ! port_open "$port" || die "Port $port is already in use"
    if [ "$accept" -eq 1 ]; then
      rm -f "$PASSWORD_FILE"
    else
      prompt_authorized_key
      password=$(python3 -c 'import secrets;print(secrets.token_urlsafe(32))')
      printf '%s' "$password" > "$PASSWORD_FILE"
    fi
    get_or_create_session
    : > "$SERVER_LOG"
    : > "$TUNNEL_LOG"
    server_flags=""
    [ "$accept" -eq 1 ] && server_flags="$server_flags --accept"
    [ "$allow_tcp_forwarding" -eq 1 ] && server_flags="$server_flags --allow-tcp-forwarding"
    if [ "$accept" -eq 1 ]; then
      NOOKWIRE_SSH_PASSWORD= nohup uv run --with "asyncssh==$ASYNCSSH_VERSION" \
        python "$server_script" --root "$root" --host 127.0.0.1 --port "$port" \
        --username "$(id -un)" $server_flags \
        >"$SERVER_LOG" 2>&1 </dev/null &
    else
      NOOKWIRE_SSH_PASSWORD=$password nohup uv run --with "asyncssh==$ASYNCSSH_VERSION" \
        python "$server_script" --root "$root" --host 127.0.0.1 --port "$port" \
        --username "$(id -un)" $server_flags \
        >"$SERVER_LOG" 2>&1 </dev/null &
    fi
    server_pid=$!
    write_pid "$server_pid" "$SERVER_PID_FILE" || {
      stop_untracked_pid "$server_pid"
      die "Unable to track server process"
    }
    ready=0
    count=0
    while [ "$count" -lt 120 ]; do
      if ! is_running "$SERVER_PID_FILE"; then break; fi
      if port_open "$port"; then
        ready=1
        break
      fi
      sleep 0.5
      count=$((count + 1))
    done
    if [ "$ready" -ne 1 ]; then
      stop_one "$SERVER_PID_FILE"
      printf 'Server failed to start. Log:\n' >&2
      tail -n 100 "$SERVER_LOG" >&2 || true
      exit 1
    fi
    backend_launch_tunnel
    write_pid "$tunnel_pid" "$TUNNEL_PID_FILE" || {
      stop_untracked_pid "$tunnel_pid"
      stop_one "$SERVER_PID_FILE"
      die "Unable to track tunnel process"
    }
    write_meta
    sleep 2
    if ! is_running "$TUNNEL_PID_FILE"; then
      stop_one "$SERVER_PID_FILE"
      rm -f "$TUNNEL_PID_FILE"
      printf 'Tunnel failed to start. Log:\n' >&2
      tail -n 100 "$TUNNEL_LOG" >&2 || true
      exit 1
    fi
    printf 'Nookwire SSH started in the background.\n'
    show_status || true
    ;;
  status)
    [ $# -eq 0 ] || die "Usage: nookwire-ssh status"
    setup_state
    show_status
    ;;
  logs)
    [ $# -le 2 ] || die "Usage: nookwire-ssh logs [all|server|tunnel] [-f]"
    target=${1:-all}
    follow=${2:-}
    [ -z "$follow" ] || [ "$follow" = "-f" ] || die "Second argument must be -f"
    setup_state
    [ -f "$SERVER_LOG" ] || : > "$SERVER_LOG"
    [ -f "$TUNNEL_LOG" ] || : > "$TUNNEL_LOG"
    case "$target:$follow" in
      all:) tail -n 100 "$SERVER_LOG" "$TUNNEL_LOG" ;;
      all:-f) tail -n 100 -f "$SERVER_LOG" "$TUNNEL_LOG" ;;
      server:) tail -n 100 "$SERVER_LOG" ;;
      server:-f) tail -n 100 -f "$SERVER_LOG" ;;
      tunnel:) tail -n 100 "$TUNNEL_LOG" ;;
      tunnel:-f) tail -n 100 -f "$TUNNEL_LOG" ;;
      *) die "Log target must be all, server, or tunnel" ;;
    esac
    ;;
  stop)
    [ $# -eq 0 ] || die "Usage: nookwire-ssh stop"
    setup_state
    stop_one "$TUNNEL_PID_FILE"
    stop_one "$SERVER_PID_FILE"
    rm -f "$STATE_DIR/meta"
    printf 'Nookwire SSH stopped.\n'
    ;;
  proxy)
    [ $# -eq 1 ] || die "Usage: nookwire-ssh proxy WSS_URL"
    command -v uv >/dev/null 2>&1 || die "uv is required (https://docs.astral.sh/uv/)"
    here=$(CDPATH= cd "$(dirname "$0")" && pwd)
    ws_script=$here/nookwire_ws.py
    [ -f "$ws_script" ] || die "Missing $ws_script; reinstall nookwire-ssh"
    exec uv run --with websockets python "$ws_script" client "$1"
    ;;
  upgrade)
    [ $# -le 1 ] || die "Usage: nookwire-ssh upgrade [REF]"
    command -v curl >/dev/null 2>&1 || die "curl is required to upgrade"
    ref=${1:-main}
    install_url=${NOOKWIRE_SSH_INSTALL_URL:-https://raw.githubusercontent.com/lars-hagen/nookwire-ssh/$ref/install.sh}
    # Install the files from the same ref, not the installer's pinned default,
    # so "upgrade main" actually installs main's launcher and companions.
    base_url=${NOOKWIRE_SSH_BASE_URL:-https://raw.githubusercontent.com/lars-hagen/nookwire-ssh/$ref}
    # A proxy or HTTP cache on the connecting machine can serve a stale copy of
    # main's installer, which then silently reinstalls the previous version.
    # Bust it with a unique query string plus no-cache request headers.
    case "$install_url" in
      *\?*) fetch_url="$install_url&nc=$(date +%s)$$" ;;
      *) fetch_url="$install_url?nc=$(date +%s)$$" ;;
    esac
    target=$(curl -fsSL -H 'Cache-Control: no-cache' -H 'Pragma: no-cache' "$fetch_url" 2>/dev/null | sed -n 's/.*NOOKWIRE_SSH_VERSION:-\([0-9][0-9.]*\).*/\1/p')
    [ -n "$target" ] || target="$ref"
    printf 'nookwire-ssh %s -> %s (from %s)\n' "$VERSION" "$target" "$install_url"
    curl -fsSL -H 'Cache-Control: no-cache' -H 'Pragma: no-cache' "$fetch_url" | NOOKWIRE_SSH_BASE_URL="$base_url" sh
    ;;
  help|-h|--help)
    usage
    ;;
  -v|--version)
    printf 'nookwire-ssh %s\n' "$VERSION"
    ;;
  *)
    usage >&2
    exit 1
    ;;
esac
